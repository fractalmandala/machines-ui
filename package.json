{
	"name": "@fractaldesign/machines-ui",
	"version": "0.1.0",
	"description": "Svelte 5 components drawn with characters: graphs, animated terminals, diagrams, and a node-and-edge workflow builder.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fractalmandala/machines-ui.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://machines.fractalsvelte.dev",
	"bugs": {
		"url": "https://github.com/fractalmandala/machines-ui/issues"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pnpm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "node scripts/build-icons.ts && svelte-kit sync && svelte-package && node scripts/build-fs.ts && node scripts/lint-fs.ts && node scripts/build-palette.ts && node scripts/lint-palette.ts && node scripts/prefix-fs.ts && node scripts/build-styles.ts && node scripts/engine-check.ts && node scripts/engine-run-check.ts && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint --flag unstable_native_nodejs_ts_config .",
		"format": "prettier --write .",
		"docs:extract": "node scripts/extract-docs.ts",
		"docs:check": "node scripts/extract-docs.ts --check",
		"docs:shots": "node scripts/docs-shots.ts",
		"docs:shots:update": "node scripts/docs-shots.ts --update",
		"predev": "node scripts/build-icons.ts && node scripts/build-fs.ts",
		"build:fs": "node scripts/build-fs.ts",
		"lint:fs": "node scripts/lint-fs.ts && node scripts/prefix-fs.ts",
		"docs:api": "svelte-package && sveld",
		"docs:api:check": "svelte-package && sveld --check=src/docs/data/COMPONENT_API.json",
		"engine:check": "node scripts/engine-check.ts",
		"engine:run-check": "node scripts/engine-run-check.ts",
		"e2e:creator": "node scripts/e2e-creator.ts",
		"engine:snapshots": "node scripts/engine-check.ts --update",
		"icons:build": "node scripts/build-icons.ts",
		"icons:check": "node scripts/build-icons.ts --check",
		"palette:build": "node scripts/build-palette.ts",
		"palette:check": "node scripts/lint-palette.ts",
		"route:check": "node scripts/route-check.ts",
		"docs:gen": "node scripts/docs-gen.ts",
		"docs:gen:strict": "node scripts/docs-gen.ts --strict",
		"docs:check:file": "node scripts/docs-check-file.ts"
	},
	"files": [
		"dist",
		"!dist/svg",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./style.css": "./dist/style.css",
		"./engine": {
			"types": "./dist/engine/index.d.ts",
			"default": "./dist/engine/index.js"
		},
		"./engine/node": {
			"types": "./dist/engine/node.d.ts",
			"default": "./dist/engine/node.js"
		}
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"svelte-sonner": "^1.2.1"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fractaldesign/fractalstyler": "^0.9.0",
		"@fractaldesign/pop": "^0.1.0",
		"@poppanator/sveltekit-svg": "^7.0.1",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"mdsvex": "^0.12.8",
		"pixelmatch": "^7.2.0",
		"playwright-core": "^1.63.0",
		"pngjs": "^7.0.0",
		"postcss": "^8.5.29",
		"postcss-selector-parser": "^7.1.6",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"publint": "^0.3.21",
		"sass": "^1.105.1",
		"sveld": "^0.38.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"graphs",
		"charts",
		"ascii",
		"terminal",
		"diagrams",
		"workflow",
		"flow-editor",
		"node-editor",
		"components"
	],
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
