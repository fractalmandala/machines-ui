{
	"jev": {
		"mcpServers": {
			"jev-router": {
				"command": "npx",
				"args": [
					"-y",
					"<your-mcp-server>",
					"--workflow",
					"jev-router"
				],
				"env": {
					"LUNA_API_KEY": "<your Luna key>",
					"JEV_API_KEY": "<your Jev key>",
					"SOL_API_KEY": "<your Sol key>"
				}
			}
		}
	},
